<!DOCTYPE html>
<html>
<head>
  <title>Zapisnik o ugradnji</title>
  <style>
    body { font-family: sans-serif; font-size: 12px; }
    .container { padding: 20px; }
    .header { text-align: center; margin-bottom: 32px; }
    .section { margin-bottom: 24px; }
    .section h2 { font-size: 14px; margin-bottom: 8px; border-bottom: 1px solid #333; }
    .details table { width: 100%; border-collapse: collapse; }
    .details th, .details td { border: 1px solid #ddd; padding: 6px 8px; text-align: left; }
    .details th { background-color: #f2f2f2; width: 35%; }
    .empty { color: #888; }
    .highlight { font-weight: bold; background-color: #f9f9f9; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Zapisnik o ugradnji broj: {{recordNumber}}</h1>
    </div>

    <div class="section">
      <h2>Podaci o SIM kartici</h2>
      <table class="details">
        <tr><th>ICCID</th><td>{{simCard.iccid}}</td></tr>
        <tr class="highlight"><th>EPBIH IP (unesite u brojilo)</th><td>{{simCard.ipAddress}}</td></tr>
        <tr><th>Javna IP adresa</th><td>{{#if simCard.publicIpAddress}}{{simCard.publicIpAddress}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Broj telefona</th><td>{{#if simCard.phoneNumber}}{{simCard.phoneNumber}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>APN</th><td>{{#if simCard.apn}}{{simCard.apn}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Kome je dodijeljena</th><td>{{#if simCard.assignedTo}}{{simCard.assignedTo}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
      </table>
    </div>

    <div class="section">
      <h2>Podaci o brojilu</h2>
      <table class="details">
        {{#if meter}}
        <tr><th>Serijski broj</th><td>{{meter.serialNumber}}</td></tr>
        <tr><th>Tip brojila (naziv)</th><td>{{#if meter.typeName}}{{meter.typeName}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Proizvođač</th><td>{{#if meter.typeManufacturer}}{{meter.typeManufacturer}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Model</th><td>{{#if meter.typeModel}}{{meter.typeModel}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Jednofazno / Trofazno</th><td>{{#if meter.typePhase}}{{meter.typePhase}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Maks. struja (A)</th><td>{{#if meter.typeMaxCurrent}}{{meter.typeMaxCurrent}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Godina</th><td>{{#if meter.year}}{{meter.year}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Lokacija instalacije</th><td>{{#if meter.installationAddress}}{{meter.installationAddress}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Datum instalacije</th><td>{{#if meter.installationDate}}{{meter.installationDate}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Mjerno mjesto (MM)</th><td>{{#if meter.measuringPoint}}{{meter.measuringPoint}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Grad / Mjesto</th><td>{{#if meter.city}}{{meter.city}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        <tr><th>Općina</th><td>{{#if meter.municipality}}{{meter.municipality}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        {{#if meter.latitude}}<tr><th>GPS širina</th><td>{{meter.latitude}}</td></tr>{{/if}}
        {{#if meter.longitude}}<tr><th>GPS dužina</th><td>{{meter.longitude}}</td></tr>{{/if}}
        <tr><th>Napomena (brojilo)</th><td>{{#if meter.notes}}{{meter.notes}}{{else}}<span class="empty">–</span>{{/if}}</td></tr>
        {{else}}
        <tr><td colspan="2"><span class="empty">Nema podataka o brojilu</span></td></tr>
        {{/if}}
      </table>
    </div>

    {{#if hasDynamicFields}}
    <div class="section">
      <h2>Dodatna polja brojila</h2>
      <table class="details">
        {{#each dynamicFields}}
        <tr><th>{{this.label}}</th><td>{{this.value}}</td></tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    {{#if hasPhotos}}
    <div class="section">
      <h2>Fotografije</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {{#each photoDataUrls}}
        <img src="{{this}}" alt="Fotografija" style="max-width: 120px; max-height: 120px; object-fit: cover; border: 1px solid #ddd;" />
        {{/each}}
      </div>
    </div>
    {{/if}}

    <div class="section">
      <h2>Zapisnik</h2>
      <table class="details">
        <tr><th>Instalater</th><td>{{installedBy.firstName}} {{installedBy.lastName}}</td></tr>
        {{#if notes}}
        <tr><th>Napomena</th><td>{{notes}}</td></tr>
        {{/if}}
      </table>
    </div>
  </div>
</body>
</html>
