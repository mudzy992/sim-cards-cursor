generator client {
  provider = "prisma-client-js"
}

// PostgreSQL je primarna baza od migracije (avgust 2026).
// MySQL konfiguracija je zadržana kao backup/rollback referenca — vidi
// docs/MIGRATION_MYSQL_TO_POSTGRES.md i backend/.env (MYSQL_BACKUP_DATABASE_URL).
// NAPOMENA: Prisma "provider" se ne može birati dinamički preko env-a — bira
// se ovdje, na build-time. Za rollback na MySQL treba vratiti "mysql" ovdje
// i ponovo generisati klijent (vidi migracioni dokument, sekcija Rollback).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  DIST_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SimCardStatus {
  AVAILABLE
  ASSIGNED
  INSTALLED
  DEMOUNTED
  DEFECTIVE
  RETURNED
  DEACTIVATED
}

enum MeterSimCardState {
  INSTALLED
  NO_SIM
}

enum MeterStatus {
  ACTIVE
  DEFECTIVE
  IN_CALIBRATION
  INACTIVE
}

enum MeterType {
  SINGLE_PHASE
  THREE_PHASE
}

enum RecordStatus {
  DRAFT
  SENT
  SEND_FAILED
  SEP_ACTIVATED
  LEGACY_COMPLETED
}

enum InstallationRecordKind {
  NEW_CONNECTION
  METER_REPLACEMENT
}

enum ShipmentStatus {
  RECEIVED
  PROCESSING
  COMPLETED
}

enum PushCampaignAudienceType {
  ALL
  FILTER
  USER
}

enum PushCampaignStatus {
  DRAFT
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum PushDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  INVALID_TOKEN
}

enum MobileAppPlatform {
  ANDROID
}

model Distribution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches            Branch[]
  users               User[]         @relation("UserDistribution")
  shipments           Shipment[]
  pushCampaignsScoped PushCampaign[]

  @@map("distributions")
}

model Branch {
  id             String       @id @default(uuid())
  distributionId String       @map("distribution_id")
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  name           String
  code           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users               User[]                 @relation("UserBranch")
  meters              Meter[]
  pushCampaignsScoped PushCampaign[]
  emailRecipients     BranchEmailRecipient[]
  branchModerators    BranchModerator[]

  @@unique([distributionId, code])
  @@index([distributionId])
  @@map("branches")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  username       String?       @unique
  password       String
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  phone          String?
  role           UserRole      @default(USER)
  status         UserStatus    @default(ACTIVE)
  avatar         String?
  refreshToken   String?       @map("refresh_token") @db.Text
  distributionId String?       @map("distribution_id")
  distribution   Distribution? @relation("UserDistribution", fields: [distributionId], references: [id], onDelete: SetNull)
  branchId       String?       @map("branch_id")
  branch         Branch?       @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  lastLoginAt    DateTime?     @map("last_login_at")

  assignedSimCards      SimCard[]            @relation("AssignedTo")
  installedRecords      InstallationRecord[] @relation("InstalledBy")
  approvedRecords       InstallationRecord[] @relation("ApprovedBy")
  importedShipments     Shipment[]           @relation("ImportedBy")
  notifications         Notification[]
  activityLogs          ActivityLog[]
  demountTasksAssigned  DemountTask[]        @relation("DemountTasksAssigned")
  demountTasksCreated   DemountTask[]        @relation("DemountTasksCreated")
  installTasksAssigned  InstallTask[]        @relation("InstallTasksAssigned")
  installTasksCreated   InstallTask[]        @relation("InstallTasksCreated")
  pushTokens            PushToken[]
  pushCampaignsCreated  PushCampaign[]       @relation("PushCampaignCreatedBy")
  mobileReleasesCreated MobileAppRelease[]   @relation("MobileAppReleaseCreatedBy")
  pushDeliveries        PushDelivery[]
  branchModeratorRoles  BranchModerator[]

  @@map("users")
}

model Shipment {
  id               String         @id @default(uuid())
  name             String
  provider         String
  receivedDate     DateTime       @map("received_date")
  totalCards       Int            @default(0) @map("total_cards")
  status           ShipmentStatus @default(RECEIVED)
  notes            String?        @db.Text
  originalFileName String?        @map("original_file_name")
  distributionId   String?        @map("distribution_id")
  distribution     Distribution?  @relation(fields: [distributionId], references: [id], onDelete: SetNull)
  importedById     String         @map("imported_by_id")
  importedBy       User           @relation("ImportedBy", fields: [importedById], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  simCards         SimCard[]

  @@map("shipments")
}

model SimCard {
  id                  String               @id @default(uuid())
  iccid               String               @unique
  ipAddress           String               @map("ip_address")
  publicIpAddress     String?              @map("public_ip_address")
  status              SimCardStatus        @default(AVAILABLE)
  phoneNumber         String?              @map("phone_number")
  apn                 String?
  shipmentId          String               @map("shipment_id")
  shipment            Shipment             @relation(fields: [shipmentId], references: [id])
  assignedToId        String?              @map("assigned_to_id")
  assignedTo          User?                @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedAt          DateTime?            @map("assigned_at")
  meter               Meter? // kroz brojilo – kartica je fizički u brojilu
  installationRecords InstallationRecord[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  events              SimEvent[]

  @@index([iccid])
  @@index([ipAddress])
  @@index([status])
  @@map("sim_cards")
}

model Meter {
  id                      String                @id @default(uuid())
  serialNumber            String                @unique @map("serial_number")
  branchId                String?               @map("branch_id")
  branch                  Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  meterTypeDefinitionId   String                @map("meter_type_definition_id")
  meterTypeDefinition     MeterTypeDefinition   @relation(fields: [meterTypeDefinitionId], references: [id], onDelete: Restrict)
  status                  MeterStatus           @default(ACTIVE)
  simCardId               String?               @unique @map("sim_card_id")
  simCard                 SimCard?              @relation(fields: [simCardId], references: [id], onDelete: SetNull)
  simCardState            MeterSimCardState     @default(NO_SIM) @map("sim_card_state")
  noSimReason             String?               @map("no_sim_reason") @db.Text
  lastSimDemountCategory  MeterDemountCategory? @map("last_sim_demount_category")
  isDemountedFromLocation Boolean               @default(false) @map("is_demounted_from_location")
  hasOpenInstallTask      Boolean               @default(false) @map("has_open_install_task")
  hasOpenDemountTask      Boolean               @default(false) @map("has_open_demount_task")
  year                    Int?
  calibrationYear         Int?                  @map("calibration_year")
  notes                   String?               @db.Text
  installationAddress     String?               @map("installation_address") @db.Text
  installationDate        DateTime?             @map("installation_date")
  city                    String?
  municipality            String?
  measuringPoint          String?               @map("measuring_point")
  latitude                Decimal?              @db.Decimal(10, 8)
  longitude               Decimal?              @db.Decimal(11, 8)
  dynamicFieldValues      Json?                 @map("dynamic_field_values")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  installationRecords     InstallationRecord[]
  demountTasks            DemountTask[]
  installTasks            InstallTask[]

  @@index([serialNumber])
  @@index([meterTypeDefinitionId])
  @@index([simCardId])
  @@index([status])
  @@map("meters")
}

model MeterTypeDefinition {
  id           String           @id @default(uuid())
  name         String
  manufacturer String?
  model        String?
  type         MeterType        @default(SINGLE_PHASE)
  maxCurrent   String?          @map("max_current")
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  meters       Meter[]
  fields       MeterTypeField[]

  @@map("meter_type_definitions")
}

model InstallationRecord {
  id                     String                 @id @default(uuid())
  recordNumber           String                 @unique @map("record_number")
  clientRequestId        String?                @unique @map("client_request_id")
  kind                   InstallationRecordKind @default(NEW_CONNECTION) @map("kind")
  demountedMeterSnapshot Json?                  @map("demounted_meter_snapshot")
  meterId                String                 @map("meter_id")
  meter                  Meter                  @relation(fields: [meterId], references: [id])
  simCardId              String?                @map("sim_card_id")
  simCard                SimCard?               @relation(fields: [simCardId], references: [id], onDelete: SetNull)
  installedById          String                 @map("installed_by_id")
  installedBy            User                   @relation("InstalledBy", fields: [installedById], references: [id])
  status                 RecordStatus           @default(DRAFT)
  approvedById           String?                @map("approved_by_id")
  approvedBy             User?                  @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt             DateTime?              @map("approved_at")
  rejectionReason        String?                @map("rejection_reason") @db.Text
  sentToEmail            String?                @map("sent_to_email")
  sentAt                 DateTime?              @map("sent_at")
  pdfPath                String?                @map("pdf_path")
  notes                  String?                @db.Text
  photos                 Json?
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  installTask            InstallTask?           @relation("InstallTaskInstallationRecord")

  @@index([recordNumber])
  @@index([status])
  @@index([meterId])
  @@index([simCardId])
  @@map("installation_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model PushToken {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   String?
  deviceId   String?        @map("device_id")
  isValid    Boolean        @default(true) @map("is_valid")
  lastUsedAt DateTime?      @map("last_used_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deliveries PushDelivery[]

  @@unique([token])
  @@index([userId])
  @@map("push_tokens")
}

model PushCampaign {
  id          String @id @default(uuid())
  createdById String @map("created_by_id")
  createdBy   User   @relation("PushCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  scopeDistributionId String?       @map("scope_distribution_id")
  scopeDistribution   Distribution? @relation(fields: [scopeDistributionId], references: [id], onDelete: SetNull)
  scopeBranchId       String?       @map("scope_branch_id")
  scopeBranch         Branch?       @relation(fields: [scopeBranchId], references: [id], onDelete: SetNull)

  title        String
  message      String                   @db.Text
  deepLink     String?                  @map("deep_link")
  audienceType PushCampaignAudienceType @map("audience_type")
  filters      Json?
  targetUserId String?                  @map("target_user_id")
  status       PushCampaignStatus       @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")

  deliveries PushDelivery[]

  @@index([createdById])
  @@index([scopeDistributionId])
  @@index([scopeBranchId])
  @@index([status, createdAt])
  @@map("push_campaigns")
}

model PushDelivery {
  id          String       @id @default(uuid())
  campaignId  String       @map("campaign_id")
  campaign    PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokenId String       @map("push_token_id")
  pushToken   PushToken    @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)

  expoTicketId     String?            @map("expo_ticket_id")
  status           PushDeliveryStatus @default(QUEUED)
  errorCode        String?            @map("error_code")
  errorMessage     String?            @map("error_message") @db.Text
  receiptCheckedAt DateTime?          @map("receipt_checked_at")
  deliveredAt      DateTime?          @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campaignId, pushTokenId])
  @@index([campaignId])
  @@index([userId])
  @@index([pushTokenId])
  @@index([status, createdAt])
  @@map("push_deliveries")
}

model MobileAppRelease {
  id           String            @id @default(uuid())
  platform     MobileAppPlatform @default(ANDROID)
  versionName  String            @map("version_name")
  versionCode  Int               @map("version_code")
  apkPath      String            @map("apk_path") @db.Text
  apkFileName  String            @map("apk_file_name")
  apkSha256    String            @map("apk_sha256")
  releaseNotes String?           @map("release_notes") @db.Text

  publishedAt      DateTime @default(now()) @map("published_at")
  mandatoryAfterAt DateTime @map("mandatory_after_at")

  createdById String @map("created_by_id")
  createdBy   User   @relation("MobileAppReleaseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platform, versionCode])
  @@index([platform, publishedAt])
  @@map("mobile_app_releases")
}

model SimEvent {
  id             String   @id @default(uuid())
  simCardId      String   @map("sim_card_id")
  simCard        SimCard  @relation(fields: [simCardId], references: [id], onDelete: Cascade)
  type           String
  recordId       String?  @map("record_id")
  userId         String?  @map("user_id")
  distributionId String?  @map("distribution_id")
  branchId       String?  @map("branch_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([simCardId])
  @@index([type])
  @@index([createdAt])
  @@map("sim_events")
}

enum DemountTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DemountTaskType {
  DEMOUNT_METER
  DEMOUNT_SIM
}

enum DemountCompletionResolution {
  FULL_DEMOUNT
  REPLACE_SIM
  REMOVE_SIM_ONLY
}

enum RemovedSimDisposition {
  MARK_DEFECTIVE
  RETURN_TO_STOCK
}

enum MeterDemountCategory {
  METER_FAULTY
  TEMPORARY_REMOVAL
  MAINTENANCE
  OTHER
}

enum InstallTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model DemountTask {
  id                             String                       @id @default(uuid())
  meterId                        String                       @map("meter_id")
  meter                          Meter                        @relation(fields: [meterId], references: [id], onDelete: Cascade)
  assignedToId                   String?                      @map("assigned_to_id")
  assignedTo                     User?                        @relation("DemountTasksAssigned", fields: [assignedToId], references: [id])
  createdById                    String                       @map("created_by_id")
  createdBy                      User                         @relation("DemountTasksCreated", fields: [createdById], references: [id])
  status                         DemountTaskStatus            @default(PENDING)
  taskType                       DemountTaskType              @default(DEMOUNT_SIM) @map("task_type")
  requestedResolution            DemountCompletionResolution? @map("requested_resolution")
  requestedReason                String?                      @map("requested_reason") @db.Text
  requestedRemovedSimDisposition RemovedSimDisposition?       @map("requested_removed_sim_disposition")
  requestedMeterDemountCategory  MeterDemountCategory?        @map("requested_meter_demount_category")
  completionResolution           DemountCompletionResolution? @map("completion_resolution")
  completionReason               String?                      @map("completion_reason") @db.Text
  removedSimDisposition          RemovedSimDisposition?       @map("removed_sim_disposition")
  meterDemountCategory           MeterDemountCategory?        @map("meter_demount_category")
  notes                          String?                      @db.Text
  completedAt                    DateTime?                    @map("completed_at")
  createdAt                      DateTime                     @default(now()) @map("created_at")
  updatedAt                      DateTime                     @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([status])
  @@map("demount_tasks")
}

model InstallTask {
  id                   String              @id @default(uuid())
  meterId              String              @map("meter_id")
  meter                Meter               @relation(fields: [meterId], references: [id], onDelete: Cascade)
  assignedToId         String?             @map("assigned_to_id")
  assignedTo           User?               @relation("InstallTasksAssigned", fields: [assignedToId], references: [id])
  createdById          String              @map("created_by_id")
  createdBy            User                @relation("InstallTasksCreated", fields: [createdById], references: [id])
  status               InstallTaskStatus   @default(PENDING)
  notes                String?             @db.Text
  installationRecordId String?             @unique @map("installation_record_id")
  installationRecord   InstallationRecord? @relation("InstallTaskInstallationRecord", fields: [installationRecordId], references: [id], onDelete: SetNull)
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([status])
  @@index([meterId])
  @@map("install_tasks")
}

model BranchModerator {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("branch_moderators")
}

model BranchEmailRecipient {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  email     String
  label     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("branch_email_recipients")
}

enum MeterFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

model MeterTypeField {
  id                    String              @id @default(uuid())
  meterTypeDefinitionId String              @map("meter_type_definition_id")
  meterTypeDefinition   MeterTypeDefinition @relation(fields: [meterTypeDefinitionId], references: [id], onDelete: Cascade)
  name                  String
  label                 String
  fieldType             MeterFieldType      @default(STRING) @map("field_type")
  isRequired            Boolean             @default(false) @map("is_required")
  isOperatorFillable    Boolean             @default(false) @map("is_operator_fillable")
  defaultValue          String?             @map("default_value")
  sortOrder             Int                 @default(0) @map("sort_order")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([meterTypeDefinitionId])
  @@map("meter_type_fields")
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
