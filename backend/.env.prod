# Database
# AKTIVNA baza (PRIMARY) — PostgreSQL, lokalni kontejner "postgres" na
# "sim-tracker-net" mreži (vidi docker-compose.vm.db.yml). Konkretna
# vrijednost je ionako override-ovana preko `environment:` u
# docker-compose.vm.app.yml (čita POSTGRES_* iz root .env) — ovdje je
# samo referentna/fallback vrijednost za direktno pokretanje kontejnera
# bez tog override-a.
DATABASE_URL="postgresql://simcard:nije,kikiriki@sim-tracker-postgres:5432/simcards"

# JWT
JWT_SECRET="8df0aaa036cbdaa7638bb023e58efba0d53478f18eaf8c477c26471c7791f73f"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="a2f29252b43c1f22335865d3b0683434e5314d2c"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3003
FRONTEND_URLS="http://ep-web-sim,http://10.10.10.30,http://10.50.255.189,https://ep-sim.epbih.ba"
UPLOAD_ROOT_PATH="/usr/app/uploads"
UPLOAD_PUBLIC_PREFIX="/backend/uploads"
APP_ENV="production"

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=100
BCRYPT_SALT_ROUNDS=12

# Seed
ADMIN_EMAIL="m.ceric@epbih.ba"
ADMIN_PASSWORD="nije,kikiriki"
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Admin"
