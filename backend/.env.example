# Database
DATABASE_URL="mysql://user:password@localhost:3306/sim_tracker"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=100
BCRYPT_SALT_ROUNDS=12

# SMTP (Email)
# Za Gmail: SMTP_FROM mora biti ista adresa kao SMTP_USER (ili ostavite prazno da se koristi SMTP_USER)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="vas@gmail.com"
SMTP_PASS="app-password"
SMTP_FROM="vas@gmail.com"

# Seed
ADMIN_EMAIL="admin@simtracker.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Admin"
