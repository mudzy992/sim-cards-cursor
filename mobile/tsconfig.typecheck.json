{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "src/*"
      ],
      "react": [
        "node_modules/@types/react",
        "../node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*",
        "../node_modules/@types/react/*"
      ]
    }
  }
}
