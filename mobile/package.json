{
  "name": "sim-tracker-mobile",
  "version": "1.0.4",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-text-extractor"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:wcag": "node scripts/check-wcag-aaa.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "test": "jest --ci --runInBand",
    "eas-build-post-install": "npm --prefix .. run build --workspace=@sim-tracker/shared",
    "build:android:vm": "bash ../scripts/mobile-build-android.sh --target vm --mode local",
    "build:android:cloud": "bash ../scripts/mobile-build-android.sh --target cloud --mode local",
    "build:android:vm:eas": "bash ../scripts/mobile-build-android.sh --target vm --mode cloud",
    "build:android:cloud:eas": "bash ../scripts/mobile-build-android.sh --target cloud --mode cloud"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.8",
    "@sim-tracker/shared": "*",
    "@tanstack/react-query": "^5.90.6",
    "axios": "^1.12.2",
    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-intent-launcher": "~55.0.16",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-text-extractor": "^2.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^55.0.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "test-renderer": "^1.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0"
  }
}
