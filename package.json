{
  "name": "sim-tracker-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:i18n": "turbo run check:i18n",
    "check:ui": "turbo run check:ui",
    "check:wcag": "turbo run check:wcag",
    "format:check": "turbo run format:check",
    "version:status": "node scripts/bump-version.mjs status",
    "version:bump": "node scripts/bump-version.mjs",
    "mobile:build:vm": "bash scripts/mobile-build-android.sh --target vm --mode local",
    "mobile:build:cloud": "bash scripts/mobile-build-android.sh --target cloud --mode local"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
