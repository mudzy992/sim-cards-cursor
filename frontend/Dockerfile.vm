# =====================================================================
# FRONTEND za VM (offline) — samo pakovanje gotovog `dist/`
# =====================================================================
# Ne radi NIKAKAV `npm install`/`npm run build` — očekuje da `dist/`
# folder već postoji u build kontekstu (./frontend/dist), napravljen
# unaprijed na mašini sa internetom preko scripts/vm-frontend-build.sh
# (koji poziva `npm run build` sa istim VITE_API_BASE_URL/VITE_API_BASE_URLS
# vrijednostima koje koristi i public build: /backend/api).
#
# Zbog toga se ovaj Dockerfile može buildati direktno na VM-u bez
# interneta — jedino što radi je COPY + nginx, oba lokalna.
# =====================================================================
FROM nginx:alpine

WORKDIR /usr/share/nginx/html

COPY dist ./
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx.conf (dijeli ga i public Dockerfile) sluša na portu 80 — EXPOSE ovdje
# mora odgovarati tom broju, inače Traefik (koji cilja port po
# loadbalancer.server.port labeli u docker-compose.vm.app.yml) ne može da se
# poveže na kontejner iako je on inače potpuno zdrav (502 Bad Gateway).
EXPOSE 80
